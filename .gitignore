# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Environment variables
.env
.env.local
.env.*.local

# Generated images/posters (in scripts folders)
poster_*.jpg
poster_*.jpeg
poster_*.png

# But ALLOW image references and gallery
!image-references/**/*.jpg
!image-references/**/*.jpeg
!image-references/**/*.png
!image-references/**/*.gif
!image-references/**/*.webp
!.claude/skills/**/assets/**/*.jpg
!.claude/skills/**/assets/**/*.jpeg
!.claude/skills/**/assets/**/*.png
!.claude/skills/**/assets/**/*.gif
!.claude/skills/**/assets/**/*.webp

# And allow workshop assets
!workshops/**/assets/**/*.jpg
!workshops/**/assets/**/*.jpeg
!workshops/**/assets/**/*.png
!workshops/**/assets/**/*.gif
!workshops/**/assets/**/*.webp

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Build outputs
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Python cache
__pycache__/
*.pyc

# Claude skills (keep structure but ignore generated content)
.claude/skills/**/scripts/node_modules/
.claude/skills/**/scripts/poster_*.jpg
.claude/skills/**/scripts/poster_*.jpeg
.claude/skills/**/scripts/poster_*.png

# Next.js build
.next/

# Audio/video files (large)
*.m4a
*.mp3
*.mp4
*.wav

# PDF files (large)
*.pdf

# Obsidian
.obsidian/

# Inbox (task processing)
inbox/

# Transcripts at root level
uriel-workshop-*.m4a
uriel-workshop-*.srt
uriel-workshop-*_transcript.json
