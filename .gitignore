# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Environment variables
.env
.env.local
.env.*.local

# Generated images/posters (in scripts folders)
poster_*.jpg
poster_*.jpeg
poster_*.png

# Allow brand assets
!brand/**/*.jpg
!brand/**/*.jpeg
!brand/**/*.png
!brand/**/*.gif
!brand/**/*.webp
!.claude/skills/**/assets/**/*.jpg
!.claude/skills/**/assets/**/*.jpeg
!.claude/skills/**/assets/**/*.png
!.claude/skills/**/assets/**/*.gif
!.claude/skills/**/assets/**/*.webp

# And allow workshop assets (avatars, references)
!workshops/**/assets/**/*.jpg
!workshops/**/assets/**/*.jpeg
!workshops/**/assets/**/*.png
!workshops/**/assets/**/*.gif
!workshops/**/assets/**/*.webp

# BUT block generated workshop artifacts (posters, slides, iterations)
# Keep avatars and reference materials only; generated content is ephemeral
workshops/**/assets/poster-*.png
workshops/**/assets/poster-*.jpg
workshops/**/assets/poster-*.jpeg
workshops/**/assets/poster_*.png
workshops/**/assets/poster_*.jpg
workshops/**/assets/poster-v*.png
workshops/**/assets/poster-v*.jpg
workshops/**/assets/slide-*.png
workshops/**/assets/slide-*.jpg
workshops/**/assets/slide-*.jpeg

# Archive (legacy code, not part of active project)
_archive/

