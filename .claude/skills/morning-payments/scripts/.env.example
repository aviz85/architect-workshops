# Morning (Green Invoice) API credentials
# Get these from: Morning dashboard → Settings → Developer Tools → API Keys
MORNING_PAYMENTS_API_KEY=your-api-key-uuid
MORNING_PAYMENTS_API_SECRET=your-api-secret

# IMPORTANT: The API key must have payment/clearing permissions.
# If you get "לא נמצא מסוף סליקה פעיל" error, create a new API key
# with full permissions in the Morning dashboard.
